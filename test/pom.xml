<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>me.legrange.typelink</groupId>
        <artifactId>type-link-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>test</artifactId>
    <name>type-link :: tests</name>
    <description>The test suite. Not published.</description>

    <properties>
        <!-- An internal suite under a name nobody should depend on. It builds and runs; it
             does not go to Central.

             maven.deploy.skip has no effect on that: central-publishing-maven-plugin replaces
             the deploy-phase binding entirely (extensions=true) and does not read it - it is a
             maven-deploy-plugin convention, and this project's release profile never engages
             maven-deploy-plugin. Left here anyway, since something else might still read it, but
             skipPublishing below is what actually keeps this module out of the bundle. Confirmed
             the hard way: 1.0.0's first release deployment included
             pkg:maven/me.legrange.typelink/test@1.0.0 with only maven.deploy.skip set. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.mavenplugins</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <configuration>
                            <skipPublishing>true</skipPublishing>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>validate-queries</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>me.legrange.typelink</groupId>
                        <artifactId>plugins</artifactId>
                        <version>${project.version}</version>
                        <executions>
                            <execution>
                                <id>validate-test-queries</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>validate-queries</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>


    <dependencies>
        <dependency>
            <groupId>me.legrange.typelink</groupId>
            <artifactId>type-link.core</artifactId>
            <version>${project.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.8.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <!-- H2 Database -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.230</version>
            <scope>test</scope>
        </dependency>
        <!-- HikariCP -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.0.1</version> <!-- Check for the latest version -->
        </dependency>
        <!-- testcontainers for real DB testing -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mariadb</artifactId>
            <version>1.21.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>1.21.3</version>
            <scope>test</scope>
        </dependency>
        <!-- drivers for real DB testing -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependency>
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.5.5</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.5.5</version>
        </dependency>
    </dependencies>
</project>